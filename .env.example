API_KEY=replace-with-a-long-random-secret
MAX_UPLOAD_MB=50
# Confidence floor: events below 45% are not reported. Higher values are allowed.
EVENT_THRESHOLD=0.45
FRAME_SAMPLE_FPS=1
# Optional local Ollama server. Must resolve to loopback; no cloud URLs are accepted.
# Leave empty unless a local Ollama vision model is configured.
OLLAMA_BASE_URL=
OLLAMA_VISION_MODEL=

